generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  SCHOOL
  UNIVERSITY
  MUSEUM
  GOVERNMENT
  INDEPENDENT
}

enum UserRole {
  ADMIN
  TEACHER
  REVIEWER
}

enum MissionType {
  CREATE_LESSON_PLAN
  ADAPT_ACTIVITY
}

enum MissionStatus {
  DRAFT
  READY_FOR_ORCHESTRATION
  PROCESSING
  COMPLETED
  FAILED
}

enum ResourceType {
  LESSON_PLAN
  ADAPTED_ACTIVITY
}

enum ResourceStatus {
  DRAFT
  VALIDATED
  ARCHIVED
}

enum ValidationStatus {
  PENDING
  PASSED
  WARNING
  FAILED
}

enum KnowledgeSourceType {
  LAW
  CURRICULUM
  GUIDELINE
  INTERNAL_RESOURCE
  TEACHER_STRATEGY
}

enum ReliabilityLevel {
  LOW
  MEDIUM
  HIGH
  OFFICIAL
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrganizationType
  region    String?
  users     User[]
  missions  Mission[]
  resources Resource[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  email          String       @unique
  phone          String?
  passwordHash   String?
  role           UserRole
  missions       Mission[]
  resources      Resource[]
  teacherProfile TeacherProfile?
  schools         School[]
  classrooms      Classroom[]
  students        Student[]
  sessions        AuthSession[]
  usageEvents     UsageEvent[]
  referralLeads   ReferralLead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([role])
}

model ReferralLead {
  id               String   @id @default(cuid())
  referrerUserId   String
  referrer          User     @relation(fields: [referrerUserId], references: [id], onDelete: Cascade)
  name              String?
  email             String?
  phone             String?
  consentConfirmed  Boolean  @default(false)
  source             String   @default("REGISTRATION")
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([referrerUserId])
  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TeacherProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalRole      String?
  schoolStage           String?
  subjects              String[]
  audiences             String[]
  municipality          String?
  state                 String?
  profileImageUrl       String?
  generationPreferences String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model School {
  id          String      @id @default(cuid())
  name        String
  municipality String?
  state       String?
  networkType String?
  ownerUserId String
  owner       User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  classrooms  Classroom[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerUserId])
}

model Classroom {
  id          String    @id @default(cuid())
  name        String
  grade       String?
  shift       String?
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  ownerUserId String
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  students    Student[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerUserId])
  @@index([schoolId])
}

model Student {
  id                 String     @id @default(cuid())
  displayName        String
  age                Int?
  classroomId        String?
  classroom          Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  pedagogicalProfile String?
  supportLevel       String?
  observations       String?
  interests          String?
  preferences        String?
  createdBy          String
  creator            User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([createdBy])
  @@index([classroomId])
}

model UsageEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([resourceId])
}

model Mission {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  type            MissionType
  status          MissionStatus @default(DRAFT)
  input           Json
  profileContext  Json?
  resources       Resource[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([createdByUserId])
  @@index([type])
}

model Resource {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdBy       User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  missionId       String?
  mission         Mission?          @relation(fields: [missionId], references: [id], onDelete: SetNull)
  type            ResourceType
  title           String
  status          ResourceStatus    @default(DRAFT)
  metadata        Json
  versions        ResourceVersion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([createdByUserId])
  @@index([missionId])
}

model ResourceVersion {
  id               String           @id @default(cuid())
  resourceId        String
  resource          Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  versionNumber     Int
  contentJson       Json
  contentText       String
  validationStatus  ValidationStatus @default(PENDING)
  validationReports ValidationReport[]
  createdAt         DateTime         @default(now())

  @@unique([resourceId, versionNumber])
  @@index([resourceId])
}

model ValidationReport {
  id                    String          @id @default(cuid())
  resourceVersionId      String
  resourceVersion        ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  pedagogicalScore       Int?
  accessibilityScore     Int?
  lgpdRiskScore          Int?
  hallucinationRiskScore Int?
  recommendations        Json?
  createdAt              DateTime        @default(now())

  @@index([resourceVersionId])
}

model KnowledgeSource {
  id               String              @id @default(cuid())
  type             KnowledgeSourceType
  title            String
  sourceUrl         String?
  citation          String?
  reliabilityLevel  ReliabilityLevel
  license           String?
  metadata          Json?
  chunks            KnowledgeChunk[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([type, reliabilityLevel])
}

model KnowledgeChunk {
  id                String          @id @default(cuid())
  knowledgeSourceId String
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  chunkText          String
  metadata           Json?
  embedding          Unsupported("vector")?
  createdAt          DateTime        @default(now())

  @@index([knowledgeSourceId])
}

model AiProvider {
  id              String   @id @default(cuid())
  name            String
  type            String
  enabled         Boolean  @default(false)
  configReference String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiCallLog {
  id               String   @id @default(cuid())
  providerId        String?
  model             String?
  purpose           String
  tokenUsage        Json?
  latencyMs         Int?
  costEstimate      Decimal?
  redactedInputHash String?
  createdAt         DateTime @default(now())

  @@index([providerId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CurriculumProvider {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  jurisdiction String
  official    Boolean  @default(true)
  status      String   @default("ACTIVE")
  sources     CurriculumSource[]
  documents   CurriculumDocument[]
  skills      CurriculumSkill[]
  importRuns  CurriculumImportRun[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model CurriculumSource {
  id         String             @id @default(cuid())
  providerId String
  provider   CurriculumProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  title      String
  sourceUrl  String
  sourceType String
  official   Boolean            @default(true)
  accessedAt DateTime?
  status     String             @default("ACTIVE")
  documents  CurriculumDocument[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([providerId, sourceUrl])
  @@index([providerId, status])
  @@index([sourceType])
}

model CurriculumDocument {
  id              String                      @id @default(cuid())
  providerId      String
  provider        CurriculumProvider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  sourceId        String
  source          CurriculumSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  title           String
  slug            String
  documentType    String
  educationStage  String?
  modality        String?
  knowledgeArea   String?
  subject         String?
  grade           String?
  schoolYear      String?
  publicationYear Int?
  officialUrl     String
  official        Boolean                     @default(true)
  status          String                      @default("DISCOVERED")
  versions        CurriculumDocumentVersion[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([providerId, title, documentType])
  @@unique([providerId, slug])
  @@index([providerId, status])
  @@index([educationStage, subject, grade])
}

model CurriculumDocumentVersion {
  id                    String                          @id @default(cuid())
  documentId            String
  document              CurriculumDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionLabel          String
  sourceUrl             String
  fileName              String
  mimeType              String
  contentHash           String
  fileSize              Int
  localStorageKey       String?
  publishedAt           DateTime?
  accessedAt            DateTime?
  importedAt            DateTime?
  processingStatus      String                          @default("PENDING")
  validationStatus      String                          @default("PENDING")
  extractionConfidence  Float?
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  importItems           CurriculumImportItem[]
  skills                CurriculumSkill[]
  knowledgeObjects      CurriculumKnowledgeObject[]
  learningExpectations  CurriculumLearningExpectation[]
  contents              CurriculumContent[]
  guidances             CurriculumGuidance[]
  reviewIssues          CurriculumReviewIssue[]
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@unique([documentId, contentHash])
  @@index([contentHash])
  @@index([documentId, processingStatus])
  @@index([validationStatus])
}

model CurriculumImportRun {
  id                  String                 @id @default(cuid())
  providerId          String
  provider            CurriculumProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  startedAt           DateTime               @default(now())
  finishedAt          DateTime?
  status              String                 @default("RUNNING")
  triggerType         String
  documentsDiscovered Int                    @default(0)
  documentsDownloaded Int                    @default(0)
  documentsSkipped    Int                    @default(0)
  documentsProcessed  Int                    @default(0)
  recordsCreated      Int                    @default(0)
  recordsUpdated      Int                    @default(0)
  recordsRejected     Int                    @default(0)
  reviewIssuesCreated Int                    @default(0)
  errorSummary        String?
  items               CurriculumImportItem[]
  reviewIssues        CurriculumReviewIssue[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([providerId, status])
  @@index([startedAt])
}

model CurriculumImportItem {
  id                 String                    @id @default(cuid())
  importRunId        String
  importRun          CurriculumImportRun       @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  documentVersionId  String
  documentVersion    CurriculumDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  status             String                    @default("PENDING")
  stage              String
  startedAt          DateTime?
  finishedAt         DateTime?
  extractedTextSize  Int?
  tableCount         Int?
  skillCount         Int?
  warningCount       Int?
  errorMessage       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([importRunId, status])
  @@index([documentVersionId])
}

model CurriculumSkill {
  id                    String                    @id @default(cuid())
  providerId            String
  provider              CurriculumProvider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  documentVersionId     String
  documentVersion       CurriculumDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  code                  String
  normalizedCode        String
  officialDescription   String
  educationStage        String?
  grade                 String?
  subject               String?
  knowledgeArea         String?
  thematicUnit          String?
  fieldOfAction         String?
  trimester             String?
  schoolYear            String?
  sourcePage            Int?
  sourceSection         String?
  rawSourceText         String?
  extractionConfidence  Float?
  validationStatus      String                    @default("PENDING")
  publicationStatus     String                    @default("DRAFT")
  official              Boolean                   @default(true)
  relationsFrom         CurriculumSkillRelation[] @relation("SourceSkillRelations")
  reviewIssues          CurriculumReviewIssue[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([documentVersionId, normalizedCode, grade, subject])
  @@index([normalizedCode])
  @@index([grade, subject])
  @@index([providerId, publicationStatus])
  @@index([validationStatus])
}

model CurriculumKnowledgeObject {
  id                   String                    @id @default(cuid())
  documentVersionId    String
  documentVersion      CurriculumDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  officialText         String
  normalizedText       String
  sourcePage           Int?
  sourceSection        String?
  extractionConfidence Float?
  validationStatus     String                    @default("PENDING")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([documentVersionId, normalizedText, sourceSection])
  @@index([normalizedText])
  @@index([validationStatus])
}

model CurriculumLearningExpectation {
  id                   String                    @id @default(cuid())
  documentVersionId    String
  documentVersion      CurriculumDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  officialText         String
  normalizedText       String
  sourcePage           Int?
  sourceSection        String?
  extractionConfidence Float?
  validationStatus     String                    @default("PENDING")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([documentVersionId, normalizedText, sourceSection])
  @@index([normalizedText])
  @@index([validationStatus])
}

model CurriculumContent {
  id                   String                    @id @default(cuid())
  documentVersionId    String
  documentVersion      CurriculumDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  title                String?
  officialText         String
  normalizedText       String
  sourcePage           Int?
  sourceSection        String?
  extractionConfidence Float?
  validationStatus     String                    @default("PENDING")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([documentVersionId, normalizedText, sourceSection])
  @@index([normalizedText])
  @@index([validationStatus])
}

model CurriculumGuidance {
  id                   String                    @id @default(cuid())
  documentVersionId    String
  documentVersion      CurriculumDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  guidanceType         String
  officialText         String
  trimester            String?
  schoolYear           String?
  sourcePage           Int?
  sourceSection        String?
  extractionConfidence Float?
  validationStatus     String                    @default("PENDING")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([documentVersionId, guidanceType])
  @@index([validationStatus])
}

model CurriculumSkillRelation {
  id               String          @id @default(cuid())
  sourceSkillId    String
  sourceSkill      CurriculumSkill @relation("SourceSkillRelations", fields: [sourceSkillId], references: [id], onDelete: Cascade)
  targetEntityType String
  targetEntityId   String
  relationType     String
  confidence       Float?
  validationStatus String          @default("PENDING")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sourceSkillId, targetEntityType, targetEntityId, relationType])
  @@index([targetEntityType, targetEntityId])
  @@index([relationType])
}

model CurriculumReviewIssue {
  id                 String                     @id @default(cuid())
  importRunId        String?
  importRun          CurriculumImportRun?       @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  documentVersionId  String?
  documentVersion    CurriculumDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  skillId            String?
  skill              CurriculumSkill?           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  entityType         String
  entityId           String?
  issueType          String
  severity           String
  message            String
  rawValue           String?
  suggestedValue     String?
  sourcePage         Int?
  status             String                     @default("OPEN")
  reviewedBy         String?
  reviewedAt         DateTime?
  resolution         String?
  decisions          CurriculumReviewDecision[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([status, severity])
  @@index([entityType, entityId])
  @@index([importRunId])
  @@index([documentVersionId])
}

model CurriculumReviewDecision {
  id            String                @id @default(cuid())
  issueId       String
  issue         CurriculumReviewIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  action        String
  previousValue String?
  approvedValue String?
  reviewer      String
  reason        String?
  decidedAt     DateTime              @default(now())

  @@index([issueId])
  @@index([reviewer])
}
